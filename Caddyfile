{$DOMAIN} {
	encode gzip zstd

	# Django API + admin
	@backend path /api/* /admin/*
	handle @backend {
		reverse_proxy web:8000
	}

	# Django collected static files
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# Vue SPA
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
